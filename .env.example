OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_S=120

CHUNK_SIZE=500
CHUNK_OVERLAP=80

TOP_K_DENSE=8
TOP_K_LEXICAL=8
TOP_K_FINAL=6
DENSE_WEIGHT=0.6
LEXICAL_WEIGHT=0.4

MAX_ACTION_STEPS=4
REUSE_SIMILARITY_THRESHOLD=0.80
REUSE_TOP_K=3

MAX_INITIAL_BRANCHES=4
MAX_TREE_DEPTH=4
MAX_ITERATIONS=25
MAX_EXPANSION_ROUNDS=3
MAX_CHILDREN_PER_BRANCH=3
